{
  "name": "afpi-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @afpi/web",
    "dev:api": "npm run start:dev --workspace @afpi/api",
    "build": "npm run build --workspace @afpi/web && npm run build --workspace @afpi/api",
    "test:poc:ml": "python -m unittest discover -s legacy/poc/services/model-training/tests -p \"test_*.py\" -v",
    "generate:poc:prediction-data": "npm --prefix legacy/poc/web run generate:prediction-data",
    "start": "npm run start --workspace @afpi/web"
  }
}
